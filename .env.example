# ==============================================================================
# eJournal System — Environment Configuration Template
# NOTE: Copy this file to '.env' and fill in your production credentials.
# NEVER commit the actual '.env' file containing real secrets to GitHub!
# ==============================================================================

# Environment (development | production)
NODE_ENV=production
ENVIRONMENT=production

# Frontend Application Configuration
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com/api/v1
NEXT_PUBLIC_WS_HOST=your-backend-service.onrender.com

# Backend Host & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["https://your-frontend.vercel.app","http://localhost:3000"]

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ejournal
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# Redis (Upstash or Redis Cloud)
REDIS_URL=rediss://default:<password>@<host>:<port>

# JWT / Cryptographic Security (Must be at least 32 characters in production)
JWT_SECRET_KEY=change-this-to-a-secure-32-char-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Brevo Transactional Email Service (Primary for Render/Vercel)
BREVO_API_KEY=xkeysib-your-brevo-api-key
SMTP_FROM_EMAIL=your-verified-email@gmail.com

# Resend Email Service (Optional Fallback)
# RESEND_API_KEY=re_your_resend_key
# SMTP_FROM_EMAIL=onboarding@resend.dev

# Cloudinary Media Storage (Optional, falls back to local /uploads/ if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
